# Hecho a Pie en Hostinger (Apache / LiteSpeed). Front y API en el mismo dominio:
#   /api/*, /uploads/*  → api/index.php → ../../sneakerlab-api (fuera de public_html)
#   archivos existentes → se sirven tal cual (assets del build, modelos, decoders)
#   /                   → index.html (landing prerenderizada, indexable)
#   cualquier otra ruta → app.html (shell de la SPA con noindex; React Router decide)
Options -MultiViews -Indexes
DirectoryIndex index.html

# Tipos que algunos servidores no conocen: modelos 3D, decoders y fuentes.
AddType model/gltf-binary .glb
AddType application/wasm .wasm
AddType font/woff2 .woff2

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Forzar HTTPS (Hostinger incluye SSL gratuito).
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteCond %{HTTP_HOST} !^localhost [NC]
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Archivos ocultos (.git, .env…) → 404. Se deja pasar .well-known (validación SSL).
  RewriteRule (^|/)\.(?!well-known/) - [R=404,L]

  # Pasar la cabecera Authorization a PHP (Bearer token).
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

  # API PHP: /api/* y /uploads/* → api/index.php
  RewriteCond %{REQUEST_URI} !^/api/index\.php$
  RewriteRule ^(api|uploads)(/.*)?$ api/index.php [L,QSA]

  # /index.html → / (una sola URL para la landing)
  RewriteCond %{THE_REQUEST} \s/index\.html[\s?] [NC]
  RewriteRule ^index\.html$ / [R=301,L]

  # SPA: cualquier otra ruta que no sea un archivo existente → app.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ app.html [L]
</IfModule>

<IfModule mod_headers.c>
  # Cabeceras básicas para los estáticos (el API PHP pone las suyas).
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"

  # Los recursos con hash del build son inmutables; index.html nunca se cachea.
  <FilesMatch "\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(glb|ktx2|wasm|png|jpg|webp|svg)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  <FilesMatch "^(index|app)\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml model/gltf-binary application/wasm
</IfModule>
