{
  "name": "sneakerlab-3d",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/prerender.mjs",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run src tests --exclude tests/api/**",
    "test:watch": "vitest",
    "model:generate": "tsx scripts/generate-provisional-model.ts",
    "decoders:copy": "rm -rf public/decoders && mkdir -p public/decoders && cp -r node_modules/three/examples/jsm/libs/draco public/decoders/draco && cp -r node_modules/three/examples/jsm/libs/basis public/decoders/basis",
    "model:prepare": "node tools/node/prepare-sneaker.mjs --input assets/src/unbranded-white-sneaker.glb --recipe tools/node/recipes/unbranded-white.json --output public/models/court-low-01.glb --manifest src/config/models/court-low-01.json --report docs/reports/court-low-01.report.json",
    "model:inspect": "node tools/node/inspect-glb.mjs",
    "designs:assets": "python3 tools/designs/build-assets.py",
    "designs:render": "node tools/designs/render-thumbs.mjs",
    "preview": "vite preview --port 3100",
    "api:contracts": "tsx scripts/export-api-contracts.ts",
    "api:install": "node scripts/api-install.mjs",
    "hosting:up": "npm run build && docker compose up -d --build --wait && docker compose exec -T web php /srv/site/sneakerlab-api/bin/migrate.php",
    "hosting:down": "docker compose down",
    "test:api": "node scripts/test-api.mjs",
    "build:hostinger": "node scripts/build-hostinger.mjs",
    "model:prepare:classic": "node tools/node/prepare-sneaker.mjs --input assets/src/air_force1.glb --recipe tools/node/recipes/court-classic.json --output public/models/court-classic-01.glb --manifest src/config/models/court-classic-01.json --report docs/reports/court-classic-01.report.json",
    "seo:og": "node tools/node/og-image.mjs",
    "model:print-sizes": "tsx scripts/measure-print-zones.mts"
  },
  "dependencies": {
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@react-three/postprocessing": "^3.2.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fflate": "^0.8.3",
    "idb-keyval": "^6.3.0",
    "immer": "^11.2.9",
    "konva": "^10.9.1",
    "lucide-react": "^1.70.0",
    "motion": "^14.10.1",
    "postprocessing": "^6.39.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-konva": "^19.3.2",
    "react-router": "^8.5.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "three": "^0.182.0",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.182.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.8",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "meshoptimizer": "^1.3.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
