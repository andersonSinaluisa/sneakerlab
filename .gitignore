# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js (ya no se usa; se conserva por si quedan restos locales)
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# despliegue
.ssh-deploy.json

# datos locales del API (PGlite, subidas)
data/

# build del frontend y paquete de despliegue
/dist
/deploy

# API PHP
/api/vendor/
/api/.env
/api/storage/uploads/*
!/api/storage/uploads/.gitkeep
